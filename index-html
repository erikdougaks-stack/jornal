    name="description"
    content="Diário Nacional — informação, análise e jornalismo."
  >

  <link
    rel="stylesheet"
    href="style.css"
  >

</head>


<body>


<header class="site-header">

  <div class="topbar">

    <div class="container header-content">

      <div class="brand">

        <span class="brand-main">
          DIÁRIO
        </span>

        <span class="brand-sub">
          NACIONAL
        </span>

      </div>


      <div class="header-info">

        <span>
          Domingo, 6 de setembro de 2026
        </span>

        <span>
          08:36
        </span>

      </div>

    </div>

  </div>


  <nav class="navigation">

    <div class="container nav-content">

      <a href="#">
        Início
      </a>

      <a href="#">
        Brasil
      </a>

      <a href="#">
        Mundo
      </a>

      <a href="#">
        Política
      </a>

      <a href="#">
